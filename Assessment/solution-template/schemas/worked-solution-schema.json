{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHHS Worked Solution Schema",
  "description": "Structured data format for generating CHHS mathematics worked solutions with marking criteria, typed working and optional diagrams.",
  "type": "object",
  "required": [
    "documentTitle",
    "school",
    "course",
    "year",
    "questions"
  ],
  "properties": {
    "documentTitle": {
      "type": "string",
      "description": "Title shown at the top of the worked solution document."
    },
    "school": {
      "type": "string",
      "default": "CHHS"
    },
    "course": {
      "type": "string",
      "description": "Course, stage or class context, e.g. Stage 4 Mathematics, Year 10, Stage 6 Mathematics Advanced."
    },
    "year": {
      "type": "string",
      "description": "Assessment year or publication year."
    },
    "mode": {
      "type": "string",
      "enum": ["teacher", "student"],
      "default": "teacher"
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": ["questionNumber", "criteria", "solution"],
      "properties": {
        "questionNumber": {
          "type": "string",
          "description": "Question label, e.g. 11(a), 12, 15(b)."
        },
        "questionText": {
          "type": "string",
          "description": "Optional original question text."
        },
        "marksTotal": {
          "type": "number"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "solution": {
          "$ref": "#/$defs/solution"
        },
        "teacherNotes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "commonErrors": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "criterion": {
      "type": "object",
      "required": ["text", "marks"],
      "properties": {
        "text": {
          "type": "string"
        },
        "marks": {
          "type": "number"
        }
      }
    },
    "solution": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "algebra",
            "diagram",
            "mixed",
            "short-answer"
          ]
        },
        "intro": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/solutionStep"
          }
        },
        "finalAnswer": {
          "type": "string"
        },
        "diagram": {
          "$ref": "#/$defs/diagram"
        },
        "diagrams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagram"
          }
        },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "solutionStep": {
      "type": "object",
      "required": ["expression"],
      "properties": {
        "expression": {
          "type": "string",
          "description": "Mathematical expression or working line. HTML entities and simple superscripts are allowed if needed."
        },
        "reason": {
          "type": "string",
          "description": "Optional explanation for this step."
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": ["engine", "config"],
      "properties": {
        "engine": {
          "type": "string",
          "enum": [
            "algebra-layout",
            "coordinate-graph",
            "geometry-engine",
            "number-line",
            "probability-tree"
          ]
        },
        "title": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "description": "Configuration object passed directly to the selected diagram engine."
        }
      }
    }
  }
}
