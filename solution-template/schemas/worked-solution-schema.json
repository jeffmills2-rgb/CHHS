{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CHHS Worked Solution Schema",
  "description": "Structured data format for generating CHHS mathematics worked solutions with marking criteria, typed working, grouped subparts and optional diagrams.",
  "type": "object",
  "required": [
    "documentTitle",
    "school",
    "course",
    "year",
    "questions"
  ],
  "properties": {
    "documentTitle": {
      "type": "string",
      "description": "Title shown at the top of the worked solution document."
    },
    "school": {
      "type": "string",
      "default": "CHHS"
    },
    "course": {
      "type": "string",
      "description": "Course, stage or class context, e.g. Stage 4 Mathematics, Year 10, Stage 6 Mathematics Advanced."
    },
    "year": {
      "type": "string",
      "description": "Assessment year or publication year."
    },
    "mode": {
      "type": "string",
      "enum": [
        "teacher",
        "student"
      ],
      "default": "teacher"
    },
    "assessmentMode": {
      "type": "string",
      "enum": [
        "standard",
        "compact"
      ],
      "default": "standard",
      "description": "Optional display hint for the renderer. Compact is useful for assessments with many subparts."
    },
    "questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "question": {
      "type": "object",
      "required": [
        "questionNumber"
      ],
      "anyOf": [
        {
          "required": [
            "solution"
          ]
        },
        {
          "required": [
            "parts"
          ]
        }
      ],
      "properties": {
        "questionNumber": {
          "type": "string",
          "description": "Parent question label, e.g. 4, 7, 11. Avoid using this for every tiny subpart when parts can be grouped."
        },
        "questionText": {
          "type": "string",
          "description": "Optional original question text or parent instruction."
        },
        "marksTotal": {
          "type": "number"
        },
        "pageBreakBefore": {
          "type": "boolean"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          },
          "description": "Optional parent marking criteria. If parts are used, criteria may be placed at parent level, part level, or both."
        },
        "solution": {
          "$ref": "#/$defs/solution",
          "description": "Legacy single-solution question format. Still supported."
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/questionPart"
          },
          "description": "Grouped subparts rendered compactly under the parent question. Use for questions such as 4(a)(i), 4(a)(ii), 4(b)(i), etc."
        },
        "teacherNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commonErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "questionPart": {
      "type": "object",
      "required": [
        "partLabel",
        "solution"
      ],
      "properties": {
        "partLabel": {
          "type": "string",
          "description": "Subpart label, e.g. a, b, c, a i, b vi. Do not include the word Question."
        },
        "questionText": {
          "type": "string",
          "description": "Optional subpart question text."
        },
        "marksTotal": {
          "type": "number"
        },
        "criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/criterion"
          }
        },
        "solution": {
          "$ref": "#/$defs/solution"
        },
        "teacherNotes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commonErrors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "criterion": {
      "type": "object",
      "required": [
        "text",
        "marks"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "marks": {
          "type": "number"
        }
      }
    },
    "solution": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "algebra",
            "diagram",
            "mixed",
            "short-answer"
          ]
        },
        "intro": {
          "type": "string"
        },
        "algebraTitle": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/solutionStep"
          }
        },
        "finalAnswer": {
          "type": "string"
        },
        "diagram": {
          "$ref": "#/$defs/diagram"
        },
        "diagrams": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagram"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "solutionStep": {
      "type": "object",
      "required": [
        "expression"
      ],
      "properties": {
        "expression": {
          "type": "string",
          "description": "Mathematical expression or working line. Use plain Unicode maths where possible."
        },
        "reason": {
          "type": "string",
          "description": "Optional explanation for this step."
        }
      }
    },
    "diagram": {
      "type": "object",
      "required": [
        "engine",
        "config"
      ],
      "properties": {
        "engine": {
          "type": "string",
         "enum": [
  "algebra-layout",
  "coordinate-graph",
  "box-plot",
  "geometry-engine",
  "network-graph",
  "integer-number-line-solution",
  "number-line",
  "probability-tree"
]
        },
        "title": {
          "type": "string"
        },
        "config": {
          "type": "object",
          "description": "Configuration object passed directly to the selected diagram engine."
        }
      }
    }
  }
}